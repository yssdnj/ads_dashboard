# 数据库文件（含业务数据，不入库）
ads_funnel/ads_funnel.db

# MySQL 连接配置（含密码，不入库）
ads_funnel/db_config.json

# v1.0 历史存档（只本地查看，不入库）
legacy/

# 原始 Excel 数据（可能含敏感信息）
data/

# 测试文件（本地调试用，不入库）
tests/

# Python 缓存
__pycache__/
*.py[cod]

# 日志
*.log
uvicorn.log
uvicorn_err.log

# 环境变量（含敏感信息，不入库）
.env

# SQL 文件（服务器数据库结构，本地备用）
sql/

# 系统文件
.DS_Store
Thumbs.db
docs/

# Market Monitor deliverables: keep the broad local-data rules above, but
# version only this feature's regression suite and approved source artifacts.
!ads_funnel/tests/
ads_funnel/tests/*
!ads_funnel/tests/conftest.py
!ads_funnel/tests/market_test_database.py
!ads_funnel/tests/test_market_monitor*.py

!ads_funnel/docs/
ads_funnel/docs/*
!ads_funnel/docs/market_monitor_daily_collection.md
!ads_funnel/docs/US_Dog Slip Leads_关键词洞察列表_2026-06_高中低关键词.xlsx
!ads_funnel/docs/superpowers/
ads_funnel/docs/superpowers/*
!ads_funnel/docs/superpowers/specs/
ads_funnel/docs/superpowers/specs/*
!ads_funnel/docs/superpowers/specs/2026-07-20-market-monitor-intelligent-dashboard-design.md
!ads_funnel/docs/superpowers/specs/2026-07-20-market-monitor-collector-design.md
!ads_funnel/docs/superpowers/specs/2026-07-20-slip-lead-leash-market-monitor-design.md
!ads_funnel/docs/superpowers/plans/
ads_funnel/docs/superpowers/plans/*
!ads_funnel/docs/superpowers/plans/2026-07-20-market-monitor-intelligent-dashboard.md
!ads_funnel/docs/superpowers/plans/2026-07-20-market-monitor-collector.md
!ads_funnel/docs/superpowers/plans/2026-07-20-slip-lead-leash-market-monitor-backend.md

# Runtime verification outputs are local-only and can be very large.
.codex_tmp/
.superpowers/brainstorm/
